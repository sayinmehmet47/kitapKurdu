# =============================================================================
# KitapKurdu Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values.
# Never commit real secrets; this file contains variable NAMES only.
# =============================================================================

# ---- Required (backend will not start without these) ----

# MongoDB connection string
MONGO_URI=

# JWT signing secrets
ACCESS_TOKEN_SECRET_KEY=
JWT_SECRET=
REFRESH_TOKEN_SECRET_KEY=

# Server port (Render injects PORT automatically; set manually for local dev)
PORT=

# Allowed CORS origin for the frontend client
CLIENT_URL=

# Public URL of this backend (used for OAuth callbacks, sitemap, etc.)
SERVER_URL=

# Google OAuth 2.0
GOOGLE_CALLBACK_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Optional: Email (SMTP) ----

# If unset, email features (verification, password reset) silently degrade.
# When set, EMAIL_USER and EMAIL_PASS are both required for SMTP auth.

EMAIL_FROM=
EMAIL_FROM_NAME=
EMAIL_HOST=
EMAIL_PASS=
EMAIL_PORT=
EMAIL_SECURE=
EMAIL_USER=

# ---- Optional: Runtime ----

# Optional Google Books API key for higher provider quotas.
GOOGLE_BOOKS_API_KEY=

# Node environment (production | development | test)
NODE_ENV=
